# Copy to `.env` (which is git-ignored) and fill in. Never commit real values.
# Real environment variables take precedence over this file.

# Home Assistant base URL
HA_URL=http://homeassistant.local:8123

# Long-lived access token: Home Assistant > your profile > Security >
# Long-lived access tokens > Create token.
HA_TOKEN=

# Temperature sensor(s) to analyse; several may be separated by commas
# (find ids with `--ha-list`)
HA_ENTITY=sensor.outdoor_temperature

# Real ids for the scripts' neutral placeholders, so household names stay out
# of the repository: comma-separated placeholder=real pairs.
HA_ENTITY_ALIASES=binary_sensor.s_basement_bedroom_door=binary_sensor.your_door,sensor.n_bedroom_temperature=sensor.your_sensor
